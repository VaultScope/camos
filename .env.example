# CAMOS (VaultScope Admin) - Environment Configuration

# API Configuration
# The base URL for the VaultScope API (VAMOS)
VITE_API_URL=http://localhost:3000/api

# Authentication Configuration (Authentik OIDC)
# The Authentik instance URL for SSO authentication
VITE_AUTHENTIK_URL=https://auth.vaultscope.de

# The OIDC client ID registered in Authentik for the admin panel
# Note: This is different from the storefront client ID
VITE_OIDC_CLIENT_ID=vaultscope-admin

# The OAuth2 callback URL (must match Authentik configuration)
# Production: https://admin.vaultscope.de/auth/callback
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
